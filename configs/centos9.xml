<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="8.0" name="ost-images">
    <description type="system">
        <author>oVirt Developers</author>
        <contact>devel@ovirt.org</contact>
        <specification>oVirt OST Image - CentOS Stream 9</specification>
    </description>
    <include from="file://configs/default.xml"/>
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-baseos-9-stream&amp;arch=x86_64&amp;protocol=https,http"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-appstream-9-stream&amp;arch=x86_64&amp;protocol=https,http"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-extras-sig-extras-common-9-stream&amp;arch=$basearch&amp;protocol=https,http"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.fedoraproject.org/metalink?repo=epel-9&amp;arch=x86_64"/>
    </repository>
    <!-- COPR -->
    <repository alias="copr_ovirt-master-snapshot">
        <source path="https://download.copr.fedorainfracloud.org/results/ovirt/ovirt-master-snapshot/centos-stream-9-x86_64/">
            <signing key="https://download.copr.fedorainfracloud.org/results/ovirt/ovirt-master-snapshot/pubkey.gpg"/>
        </source>
    </repository>
    <packages type="image">
        <package name="ovirt-release-master"/>
    </packages>
    <include from="file://configs/packages.xml"/>
</image>