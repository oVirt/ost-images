<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="8.0" name="ost-images">
    <description type="system">
        <author>oVirt Developers</author>
        <contact>devel@ovirt.org</contact>
        <specification>oVirt OST Image - AlmaLinux 9</specification>
    </description>
    <include from="file://configs/default.xml"/>
    <repository sourcetype="mirrorlist">
        <source path="https://mirrors.almalinux.org/mirrorlist/9/baseos?arch=$basearch&amp;protocol=https"/>
    </repository>
    <repository sourcetype="mirrorlist">
        <source path="https://mirrors.almalinux.org/mirrorlist/9/appstream?arch=$basearch&amp;protocol=https"/>
    </repository>
    <repository sourcetype="mirrorlist">
        <source path="https://mirrors.almalinux.org/mirrorlist/9/extras?arch=$basearch&amp;protocol=https"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.fedoraproject.org/metalink?repo=epel-9&amp;arch=x86_64"/>
    </repository>
    <!-- oVirt Master Snapshot -->
    <repository alias="ovirt-master-snapshot">
        <source path="https://resources.ovirt.org/pub/ovirt-master-snapshot/rpm/el9/x86_64/"/>
    </repository>
    <packages type="image">
        <package name="ovirt-release-master"/>
    </packages>
    <include from="file://configs/packages.xml"/>
</image>