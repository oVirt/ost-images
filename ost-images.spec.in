%{!?distro: %global distro centos}
%{!?distro_version: %global distro_version 9}
%{!?release: %global release @PACKAGE_RELEASE@}

# RPM compression parameters
%{!?xz_num_threads: %global xz_num_threads 2}
%global _source_payload w9T%{xz_num_threads}.xzdio
%global _binary_payload w9T%{xz_num_threads}.xzdio

# Whether certain RPMs are built or not
%{!?with_storage: %global with_storage 0}
%{!?with_engine_installed: %global with_engine_installed 0}
%{!?with_host_installed: %global with_host_installed 0}
%{!?with_he_installed: %global with_he_installed 0}

# Disable debuginfo package, since this is a meta-package
%global debug_package %{nil}

Name: ost-images
Version: 1
Release: %{release}
Summary: VM images needed to run OST
License: GPLv2+
Source0: %{name}-%{version}.tar.gz
Prefix: %{_datarootdir}

BuildRequires: autoconf
BuildRequires: automake
BuildRequires: make
BuildRequires: qemu-img

%global base_version %{version}-%{release}

%description
VM images needed to run OST

%prep
%setup

%build
%configure --with-distro=%{distro} --with-distro-version=%{distro_version}

%install
%make_install

%package %{distro}%{distro_version}-base
Summary: Bare distro installation image with ssh key for root injected
Obsoletes: %{name}-%{distro}%{distro_version}-upgrade < %{base_version}

%description %{distro}%{distro_version}-base
Bare distro installation image with ssh key for root injected

%files %{distro}%{distro_version}-base
%{_datarootdir}/%{name}/*_id_rsa*
%attr(444, -, -) %{_datarootdir}/%{name}/*-base.qcow2
%{_datarootdir}/%{name}/*-base.packages

%if %{with_storage}

%package %{distro}%{distro_version}-storage
Summary: Distro with storage

%description %{distro}%{distro_version}-storage
Distro with storage

%files %{distro}%{distro_version}-storage
%attr(444, -, -) %{_datarootdir}/%{name}/*-storage.qcow2
%{_datarootdir}/%{name}/*-storage.packages

%endif


%if %{with_engine_installed}

%package %{distro}%{distro_version}-engine-installed
Summary: Distro with ovirt-engine installed
Requires: %{name}-%{distro}%{distro_version}-base = %{base_version}
Obsoletes: %{name}-%{distro}%{distro_version}-engine-deps-installed < %{base_version}

%description %{distro}%{distro_version}-engine-installed
Distro with ovirt-engine installed

%files %{distro}%{distro_version}-engine-installed
%attr(444, -, -) %{_datarootdir}/%{name}/*-engine-installed.qcow2
%{_datarootdir}/%{name}/*-engine-installed.packages

%endif

%if %{with_host_installed}

%package %{distro}%{distro_version}-host-installed
Summary: Distro with ovirt-host installed
Requires: %{name}-%{distro}%{distro_version}-base = %{base_version}
Obsoletes: %{name}-%{distro}%{distro_version}-host-deps-installed < %{base_version}

%description %{distro}%{distro_version}-host-installed
Distro with ovirt-host installed

%files %{distro}%{distro_version}-host-installed
%attr(444, -, -) %{_datarootdir}/%{name}/*-host-installed.qcow2
%{_datarootdir}/%{name}/*-host-installed.packages

%endif

%if %{with_he_installed}

%package %{distro}%{distro_version}-he-installed
Summary: Distro with ovirt-engine-appliance installed
Requires: %{name}-%{distro}%{distro_version}-host-installed = %{version}-%{release}

%description %{distro}%{distro_version}-he-installed
Distro with ovirt-engine-appliance installed

%files %{distro}%{distro_version}-he-installed
%attr(444, -, -) %{_datarootdir}/%{name}/*-he-installed.qcow2
%{_datarootdir}/%{name}/*-he-installed.packages

%endif
